{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quickdraw.vizdoom-environment-contract.v1.schema.json",
  "title": "QuickDraw ViZDoom environment contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_id",
    "status",
    "environment",
    "observation",
    "actions",
    "timing",
    "reward",
    "episode_end",
    "reset",
    "state_channel",
    "qa"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/environment-contract-v1.schema.json"
    },
    "schema_version": {
      "const": "quickdraw.vizdoom-environment-contract.v1"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^quickdraw\\.vizdoom-[a-z0-9-]+\\.v[1-9][0-9]*$"
    },
    "status": {
      "enum": ["proposed", "accepted", "deprecated"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "scenario"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["basic", "strategic"]},
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config_path",
            "wad_path",
            "artifact_status",
            "config_sha256",
            "wad_sha256"
          ],
          "properties": {
            "config_path": {"type": "string", "minLength": 1},
            "wad_path": {"type": "string", "minLength": 1},
            "artifact_status": {"enum": ["planned", "available"]},
            "config_sha256": {"$ref": "#/$defs/nullable_sha256"},
            "wad_sha256": {"$ref": "#/$defs/nullable_sha256"}
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "preprocessing", "output", "stack"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "width", "height"],
          "properties": {
            "format": {"enum": ["GRAY8"]},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "preprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crop", "resize", "normalization"],
          "properties": {
            "crop": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "width", "height"],
              "properties": {
                "kind": {"enum": ["center"]},
                "width": {"type": "integer", "minimum": 1},
                "height": {"type": "integer", "minimum": 1}
              }
            },
            "resize": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "width", "height"],
              "properties": {
                "algorithm": {"enum": ["area"]},
                "width": {"type": "integer", "minimum": 1},
                "height": {"type": "integer", "minimum": 1}
              }
            },
            "normalization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "divisor", "minimum", "maximum"],
              "properties": {
                "kind": {"enum": ["divide"]},
                "divisor": {"type": "number", "exclusiveMinimum": 0},
                "minimum": {"type": "number"},
                "maximum": {"type": "number"}
              }
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "dtype", "channel_order", "frame_order"],
          "properties": {
            "shape": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "integer", "minimum": 1}
            },
            "dtype": {"enum": ["float32"]},
            "channel_order": {"enum": ["HWC"]},
            "frame_order": {"enum": ["oldest_to_newest"]}
          }
        },
        "stack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "reset_fill"],
          "properties": {
            "count": {"type": "integer", "minimum": 1},
            "reset_fill": {"enum": ["repeat_first_post_reset_frame"]}
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mask_polarity",
        "decision_strobe",
        "button_order",
        "branches"
      ],
      "properties": {
        "mask_polarity": {"enum": ["true_means_unavailable"]},
        "decision_strobe": {"type": "string", "minLength": 1},
        "button_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/action_branch"}
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulation_hz",
        "policy_interval_pattern_tics",
        "policy_hz_average",
        "decision_limit",
        "episode_tics"
      ],
      "properties": {
        "simulation_hz": {"type": "integer", "minimum": 1},
        "policy_interval_pattern_tics": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "policy_hz_average": {"type": "number", "exclusiveMinimum": 0},
        "decision_limit": {"type": "integer", "minimum": 1},
        "episode_tics": {"type": "integer", "minimum": 1}
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregation", "terms"],
      "properties": {
        "aggregation": {"enum": ["additive"]},
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reward_term"}
        }
      }
    },
    "episode_end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal", "truncation", "infrastructure_invalid"],
      "properties": {
        "terminal": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/terminal_reason"}
        },
        "truncation": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/truncation_reason"}
        },
        "infrastructure_invalid": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/infrastructure_reason"}
        }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_seed",
        "episode_index_origin",
        "agent_start_slot",
        "target_slot",
        "remaining_ammunition",
        "cooldown_decisions"
      ],
      "properties": {
        "scenario_seed": {"type": "integer", "minimum": 0},
        "episode_index_origin": {"type": "integer", "minimum": 0},
        "agent_start_slot": {"type": "integer"},
        "target_slot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum", "sampling"],
          "properties": {
            "minimum": {"type": "integer"},
            "maximum": {"type": "integer"},
            "sampling": {"type": "string", "minLength": 1}
          }
        },
        "remaining_ammunition": {"type": "integer", "minimum": 0},
        "cooldown_decisions": {"type": "integer", "minimum": 0}
      }
    },
    "state_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "schema_id", "variables"],
      "properties": {
        "transport": {"enum": ["acs_user_variables"]},
        "schema_id": {"type": "integer", "minimum": 1},
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/state_variable"}
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_trace_path", "profiles"],
      "properties": {
        "canonical_trace_path": {"type": "string", "minLength": 1},
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dev", "integration", "training-smoke"],
          "properties": {
            "dev": {"$ref": "#/$defs/qa_profile"},
            "integration": {"$ref": "#/$defs/qa_profile"},
            "training-smoke": {"$ref": "#/$defs/training_smoke_profile"}
          }
        }
      }
    }
  },
  "$defs": {
    "nullable_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "semantic", "button"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "semantic": {"type": "string", "minLength": 1},
        "button": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "action_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "actions"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    },
    "reward_term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "value"],
      "properties": {
        "event": {"type": "string", "minLength": 1},
        "value": {"type": "number"}
      }
    },
    "terminal_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "code", "bootstrap"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "code": {"type": "integer", "minimum": 1},
        "bootstrap": {"const": false}
      }
    },
    "truncation_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "code", "at_decision", "bootstrap"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "code": {"type": "integer", "minimum": 1},
        "at_decision": {"type": "integer", "minimum": 1},
        "bootstrap": {"const": true}
      }
    },
    "infrastructure_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "code"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "code": {"type": "integer", "minimum": 1}
      }
    },
    "state_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "name"],
      "properties": {
        "slot": {"type": "string", "pattern": "^USER([1-9]|[1-5][0-9]|60)$"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "qa_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgets", "validators"],
      "properties": {
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process_launches",
            "trace_collections",
            "training_sessions",
            "external_calls"
          ],
          "properties": {
            "process_launches": {"type": "integer", "minimum": 0},
            "trace_collections": {"type": "integer", "minimum": 0},
            "training_sessions": {"type": "integer", "minimum": 0},
            "external_calls": {"type": "integer", "minimum": 0}
          }
        },
        "validators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "training_smoke_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budgets",
        "validators",
        "seeds",
        "steps",
        "warmup",
        "batch_size",
        "device"
      ],
      "properties": {
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process_launches",
            "trace_collections",
            "training_sessions",
            "external_calls"
          ],
          "properties": {
            "process_launches": {"type": "integer", "minimum": 0},
            "trace_collections": {"type": "integer", "minimum": 0},
            "training_sessions": {"type": "integer", "minimum": 0},
            "external_calls": {"type": "integer", "minimum": 0}
          }
        },
        "validators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "seeds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "steps": {"type": "integer", "minimum": 1},
        "warmup": {"type": "integer", "minimum": 0},
        "batch_size": {"type": "integer", "minimum": 1},
        "device": {"type": "string", "minLength": 1}
      }
    }
  }
}
